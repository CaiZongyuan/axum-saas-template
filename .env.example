# Local development only. Keep .env untracked.
DATABASE_URL=postgres://saas:saas-local@127.0.0.1:5432/saas
POSTGRES_PASSWORD=saas-local
POSTGRES_PORT=5432
APP_BIND=127.0.0.1:3000
RUST_LOG=info
VITE_API_PROXY=http://127.0.0.1:3000
VITE_DOCS_URL=https://caizongyuan.github.io/axum-saas-template/
MIGRATION_TIMEOUT_SECS=30
APP_ORIGIN=http://127.0.0.1:5173
SESSION_ABSOLUTE_SECS=604800
SESSION_IDLE_SECS=86400
RUSTFS_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=saas-files
S3_REGION=us-east-1
S3_ACCESS_KEY=saas-local-access
S3_SECRET_KEY=saas-local-storage-secret
FILE_MAX_BYTES=20971520
UPLOAD_SESSION_SECS=900
DOWNLOAD_URL_SECS=60
